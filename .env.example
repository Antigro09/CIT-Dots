# Copy to .env. Keep .env private and outside Git.
# Node 24 is required. These services bind to loopback by default.
CIT_CONTROL_URL=http://127.0.0.1:4318
CIT_EVE_URL=http://127.0.0.1:4319
CIT_DATA_DIR=.cit-data

# Optional. Leave unset to generate/read .cit-data/internal-token (mode 0600).
# Never expose this token to the browser or include it in a model prompt.
# CIT_INTERNAL_TOKEN=

# Disable Ollama cloud features when the Ollama service inherits this variable.
# Configure its own service environment as well if Ollama runs separately.
OLLAMA_NO_CLOUD=1

# Desktop bridge interval; polling does not itself create notifications.
CIT_NOTIFICATION_POLL_SECONDS=10

# Keep CIT_TEST_HOST_RUNNER unset on a real workstation.
